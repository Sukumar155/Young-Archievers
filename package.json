{
  "name": "disaster-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/sos-server.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke:flood": "node scripts/flood-model-smoke.mjs",
    "smoke:weather": "node scripts/weather-smoke.mjs",
    "verify:flood": "node scripts/verify-flood-model.mjs",
    "test:api": "node scripts/api-smoke.mjs",
    "smoke:yolo": "node scripts/yolo-smoke.mjs",
    "verify:sensors": "node scripts/verify-live-sensors.mjs",
    "verify:text": "python scripts/verify-text.py",
    "verify:banner": "node scripts/verify-alert-banner.mjs",
    "verify:css": "python scripts/check-css-comments.py",
    "roster": "node scripts/roster.mjs",
    "roster:add": "node scripts/roster.mjs",
    "db:migrate": "node scripts/migrate.mjs",
