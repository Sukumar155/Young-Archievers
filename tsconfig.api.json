{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* The function is a Node serverless handler, so it resolves like Node. */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /*
     * The handler imports the bridge from ../../server/sos-server.mjs, which is
     * plain JavaScript. allowJs lets TypeScript follow it so the shared
     * dispatcher is actually typechecked instead of resolving to `any` — an
     * untypechecked api/ folder is how a rename in the bridge ships broken.
     */
    "allowJs": true,
    "checkJs": false,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api", "server"]
}
